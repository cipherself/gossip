{:paths ["src"]
 :deps {org.clojure/clojure {:mvn/version "1.12.6"}
        udp-wrapper/udp-wrapper {:mvn/version "0.1.3"}
        overtone/at-at {:mvn/version "1.2.0"}}
 :aliases
 {:test {:extra-paths ["test" "dev"]
         :extra-deps {org.clojure/test.check {:mvn/version "1.1.3"}}
         :main-opts ["-m" "gossip.test-runner"]}
  :simulate {:extra-paths ["dev" "test"]
             :main-opts ["-m" "gossip.simulation"]}
  :build {:deps {org.clojure/clojure {:mvn/version "1.12.6"}
                 io.github.clojure/tools.build {:mvn/version "0.10.14"}
                 slipset/deps-deploy {:mvn/version "0.2.5"}}
          :ns-default build}}}
